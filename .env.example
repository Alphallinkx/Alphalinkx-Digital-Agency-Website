# SQLite paths are relative to the project root. Use an absolute persistent path in production.
DATABASE_URL="file:./prisma/local.db"

# Generate with openssl rand -hex 32.
JWT_SECRET=

# Public origin without a trailing slash. Set this to the production HTTPS URL behind a proxy.
APP_ORIGIN=

# Use a single IP header only when the reverse proxy overwrites it for every request.
TRUSTED_CLIENT_IP_HEADER=

# Optional email delivery. Leave unset to store inquiries without sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AGENCY_NOTIFICATION_EMAIL=
