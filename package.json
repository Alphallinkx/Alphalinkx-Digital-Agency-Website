{
  "name": "alphalinkx-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start -H 127.0.0.1",
    "postinstall": "prisma generate",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "db:migrate": "node prisma/ensure-sqlite.mjs && prisma migrate deploy",
    "db:admin": "node --import tsx prisma/admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
